---
/**
 * Font landingu doklejany do <head> stron formularza wydarzenia. Panel chodzi na foncie
 * systemowym, więc bez tego podgląd pokazywałby właściwy układ w niewłaściwym kroju.
 * Bez wariantu <noscript>: bez JavaScriptu podglądu nie ma i font nie ma czego ubrać.
 */
const QUICKSAND_HREF =
  "https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href={QUICKSAND_HREF}
  onload="this.onload=null;this.rel='stylesheet'"
/>
