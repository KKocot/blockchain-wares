---
import Layout from "../layouts/Layout.astro";
import {
  Navigation,
  Hero,
  About,
  Expertise,
  OurWorks,
  EndUsers,
  Team,
  Career,
  Contact,
  Footer,
} from "../components";
---

<Layout>
  <Navigation client:load />
  <Hero client:load />

  <div class="relative overflow-x-hidden">
    <div class="absolute inset-0 pointer-events-none overflow-hidden" style="z-index: 0;">
      <!-- Blob 1: starts with negative top to overlap Hero fade-out zone -->
      <div
        class="absolute w-[800px] h-[800px] md:w-[1200px] md:h-[1200px]"
        style="top: -300px; left: 15%; background: radial-gradient(circle, oklch(71% 0.143 215.221 / 0.12) 0%, transparent 60%);"
      ></div>

      <!-- Blob 2-8: evenly distributed using percentage-based positioning -->
      <div
        class="absolute w-[800px] h-[800px] md:w-[1200px] md:h-[1200px]"
        style="top: 12%; right: 10%; background: radial-gradient(circle, oklch(65% 0.15 280 / 0.10) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[900px] h-[900px] md:w-[1300px] md:h-[1300px]"
        style="top: 25%; left: 50%; transform: translateX(-50%); background: radial-gradient(circle, oklch(71% 0.143 215.221 / 0.12) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[800px] h-[800px] md:w-[1200px] md:h-[1200px]"
        style="top: 38%; left: 10%; background: radial-gradient(circle, oklch(65% 0.15 280 / 0.10) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[800px] h-[800px] md:w-[1200px] md:h-[1200px]"
        style="top: 50%; right: 15%; background: radial-gradient(circle, oklch(71% 0.143 215.221 / 0.12) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[900px] h-[900px] md:w-[1300px] md:h-[1300px]"
        style="top: 62%; left: 50%; transform: translateX(-50%); background: radial-gradient(circle, oklch(65% 0.15 280 / 0.10) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[800px] h-[800px] md:w-[1200px] md:h-[1200px]"
        style="top: 75%; left: 20%; background: radial-gradient(circle, oklch(71% 0.143 215.221 / 0.12) 0%, transparent 60%);"
      ></div>

      <div
        class="absolute w-[900px] h-[900px] md:w-[1300px] md:h-[1300px]"
        style="top: 88%; right: 15%; background: radial-gradient(circle, oklch(65% 0.15 280 / 0.10) 0%, transparent 60%);"
      ></div>
    </div>

    <div class="relative" style="z-index: 1;">
      <About client:visible />
      <Expertise client:visible />
      <OurWorks client:visible />
      <EndUsers client:visible />
      <Team client:visible />
      <Career client:visible />
      <Contact client:visible />
      <Footer />
    </div>
  </div>
</Layout>
