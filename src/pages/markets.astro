---
import Layout from "../layouts/Layout.astro";
import { Navigation, Markets, Footer } from "../components";
import { EVENTS, to_iso_day } from "../components/events-data";

const current_path = Astro.url.pathname;
const today_iso = to_iso_day(new Date());

const title = "Markets & Events — BlockchainWares";
const description =
  "Meet BlockchainWares at industry trade fairs and conferences. We are going to the European Blockchain Convention 2026 in Barcelona, 16–17 September.";

/** `</script>` inside any event field would break out of the JSON-LD block */
const to_json_ld = (data: unknown): string =>
  JSON.stringify(data).replace(
    /[<>&]/g,
    (char) => `\\u${char.charCodeAt(0).toString(16).padStart(4, "0")}`,
  );

const event_schemas = EVENTS.map((event) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.name,
  description: event.description,
  image: new URL(event.image, Astro.site).href,
  startDate: event.startDate,
  endDate: event.endDate,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  url: event.url,
  location: {
    "@type": "Place",
    name: event.city,
    address: {
      "@type": "PostalAddress",
      addressLocality: event.city,
      addressCountry: event.countryCode,
    },
  },
  organizer: {
    "@type": "Organization",
    name: event.organizer.name,
    url: event.organizer.url,
  },
}));
---

<Layout title={title} description={description}>
  <Navigation client:load currentPath={current_path} />

  <div class="relative bg-base-100 overflow-clip">
    <div class="absolute inset-0 pointer-events-none z-0">
      <div
        class="absolute top-[-10%] left-[5%] w-[800px] h-[800px] md:w-[1100px] md:h-[1100px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.14) 0%, transparent 70%);"
      >
      </div>
      <div
        class="absolute top-[40%] left-[55%] w-[900px] h-[900px] md:w-[1200px] md:h-[1200px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.1) 0%, transparent 70%);"
      >
      </div>
    </div>

    <div class="relative z-[1]">
      <Markets client:load todayIso={today_iso} />
      <Footer currentPath={current_path} />
    </div>
  </div>

  {
    event_schemas.length > 0 && (
      <script type="application/ld+json" set:html={to_json_ld(event_schemas)} />
    )
  }
</Layout>
