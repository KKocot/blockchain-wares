---
import Layout from "../layouts/Layout.astro";
import { Navigation, Markets, Footer } from "../components";
import {
  MARKETS_PATH,
  to_iso_day,
  type TradeFairEvent,
} from "../components/events-data";
import { build_event_schema, to_json_ld } from "../components/event-schema";
import { build_markets_description } from "../components/events-meta";
import { load_events } from "../lib/events";

const current_path = Astro.url.pathname;
const now = new Date();
const today_iso = to_iso_day(now);

// `load_events()` rzuca tylko przy pustym cache — pusta lista daje panel stanu
// pustego w `Markets` i stronę bez JSON-LD, zamiast 500 na trasie marketingowej.
let events: TradeFairEvent[] = [];
try {
  events = (await load_events()).events;
  // Odpowiedz nie zalezy od sesji ani od naglowkow zadania — brzeg moze ja
  // powtarzac zamiast wolac funkcje przy kazdym wejsciu.
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=60, stale-while-revalidate=300",
  );
} catch (cause) {
  // Render awaryjny nie ma prawa zamarznac na brzegu na czas trwania okna swr.
  Astro.response.headers.set("Cache-Control", "no-store");
  console.error(
    "[markets] events source failed:",
    cause instanceof Error ? cause.message : "unknown error",
  );
}

const title = "Markets & Events — BlockchainWares";
// Named events would freeze here on the day of the build; the calendar lives in the API
const description = build_markets_description(events, now);

// Wydarzenie bez daty nie dostaje bloku `Event` — `startDate` jest w schema.org
// wymagany, a znacznik odrzucony przez Google jest gorszy niz jego brak.
const event_schemas = events
  .map((event) => build_event_schema(event, Astro.site))
  .filter((schema) => schema !== null);
---

<Layout title={title} description={description} canonicalPath={MARKETS_PATH}>
  <Navigation client:load currentPath={current_path} />

  <div class="relative bg-base-100 overflow-clip">
    <div class="absolute inset-0 pointer-events-none z-0">
      <div
        class="absolute top-[-10%] left-[5%] w-[800px] h-[800px] md:w-[1100px] md:h-[1100px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.14) 0%, transparent 70%);"
      >
      </div>
      <div
        class="absolute top-[40%] left-[55%] w-[900px] h-[900px] md:w-[1200px] md:h-[1200px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.1) 0%, transparent 70%);"
      >
      </div>
    </div>

    <div class="relative z-[1]">
      <Markets client:load events={events} todayIso={today_iso} />
      <Footer currentPath={current_path} />
    </div>
  </div>

  {
    event_schemas.length > 0 && (
      <script type="application/ld+json" set:html={to_json_ld(event_schemas)} />
    )
  }
</Layout>
